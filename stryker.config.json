{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-core.json",
	"testRunner": "vitest",
	"mutate": ["src/**/*.{js,jsx}", "scripts/**/*.js", "!**/*.test.{js,jsx}"],
	"ignorePatterns": [
		"dist",
		"tests",
		"build",
		"reports",
		"playwright-report",
		"test-results",
		"screenshots",
		".claude"
	],
	"coverageAnalysis": "perTest",
	"timeoutMS": 10000,
	"timeoutFactor": 2,
	"thresholds": { "high": 80, "low": 70, "break": 75 },
	"reporters": ["json", "clear-text", "progress"],
	"jsonReporter": { "fileName": "reports/mutation/mutation.json" }
}
